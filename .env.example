NEXT_PUBLIC_SITE_URL=https://solo.flowsight.site
NEXT_PUBLIC_APP_URL=https://app.flowsight.site
NEXT_PUBLIC_COMPANY_URL=https://flowsight.site
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional. Increases the GitHub API rate limit for release resolution.
GITHUB_TOKEN=

# Optional release pins. Leave blank to resolve the latest stable artifacts.
NEXT_PUBLIC_AGENT_RELEASE_TAG=
NEXT_PUBLIC_AGENT_MAC_RELEASE_TAG=
NEXT_PUBLIC_AGENT_LINUX_RELEASE_TAG=

# Individual official installers: keep checkout disabled until all values below
# are configured, the private objects exist, and test purchases have passed.
INDIVIDUAL_CHECKOUT_ENABLED=false
# The Solo frontend can proxy purchases to a verified immutable deployment with
# existing server credentials. These values are server-only; never NEXT_PUBLIC.
INDIVIDUAL_PURCHASE_SERVICE_URL=
INDIVIDUAL_PURCHASE_SERVICE_ACCESS=
# Separate institutional gate. Requires INDIVIDUAL_CHECKOUT_ENABLED=true and
# the bulk-license migration, payment, delivery and activation checks to pass.
BULK_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
# Use the one-time Price ID (price_...), not the Product ID (prod_...).
# It must be active, EUR 20.00, tax-inclusive, and belong to the existing
# FlowSight Individual product in the same Stripe account as STRIPE_SECRET_KEY.
STRIPE_PRICE_INDIVIDUAL_LOCAL=
# Separate one-time EUR 10.00 tax-inclusive Price ID for orders of 100–500
# licenses. Institutional checkout is outside this release; keep it disabled.
STRIPE_PRICE_BULK_LOCAL=
# Signing secret (whsec_...) for the dedicated /api/purchase/webhook endpoint.
STRIPE_INDIVIDUAL_WEBHOOK_SECRET=
# Both stated prices are final totals per license, including applicable tax.
INDIVIDUAL_TAX_BEHAVIOR=inclusive
# Production uses the existing private Supabase storage and official GitHub
# release assets. Legacy Supabase-table/R2/Resend delivery remains supported.
INDIVIDUAL_LICENSE_BACKEND=supabase_storage
INDIVIDUAL_INSTALLER_DELIVERY=github
INDIVIDUAL_DELIVERY_NOTIFICATION=stripe_invoice
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# A stable 32-byte secret in hex (64 hex characters), generated securely once.
# Rotating it without migrating existing licenses would invalidate their codes.
INDIVIDUAL_LICENSE_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# One paid session grants access to all three operating systems. All five private
# installer variants are required before checkout opens.
INDIVIDUAL_WINDOWS_OBJECT_KEY=
INDIVIDUAL_MAC_ARM_OBJECT_KEY=
INDIVIDUAL_MAC_INTEL_OBJECT_KEY=
INDIVIDUAL_LINUX_DEB_OBJECT_KEY=
INDIVIDUAL_LINUX_APPIMAGE_OBJECT_KEY=
INDIVIDUAL_WINDOWS_RELEASE_URL=
INDIVIDUAL_MAC_ARM_RELEASE_URL=
INDIVIDUAL_MAC_INTEL_RELEASE_URL=
INDIVIDUAL_LINUX_DEB_RELEASE_URL=
INDIVIDUAL_LINUX_APPIMAGE_RELEASE_URL=
